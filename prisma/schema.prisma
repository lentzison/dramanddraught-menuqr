// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  name        String   // Greensboro, Raleigh, Durham, etc.
  slug        String   @unique // URL slug: greensboro, raleigh, etc.
  address     String?
  city        String
  state       String   @default("NC")
  zipCode     String?
  phone       String?
  email       String?
  hours       Json?    // Store hours as JSON object
  links       Json?    // Linktree-style buttons: [{label, url}]
  description String?
  image       String?  // URL to location image
  qrCode      String?  // URL to QR code image

  // Location-specific content
  menuUrl     String?  // Link to menu
  specialText String?  // Special announcements
  features    String[] // Array of features: ["outdoor seating", "delivery", etc.]

  // Social media links
  facebook    String?
  instagram   String?
  twitter     String?

  // Status
  isActive    Boolean  @default(true)

  // Hiring flag — controls the public "We're Hiring" badge on /{slug} and
  // whether /{slug}/apply accepts new applications. Default off.
  isHiring    Boolean  @default(false)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  menuCategories   MenuCategory[]
  events           Event[]
  dayThemes        DayTheme[]
  flights          Flight[]
  featuredBottles  FeaturedBottle[]
  guestFeedbacks   GuestFeedback[]
  visitorSessions  VisitorSession[]
  jobApplications  JobApplication[]
  interviews       Interview[]
  ltos             LimitedTimeOffer[]

  @@index([slug])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model DayTheme {
  id          String     @id @default(uuid())
  dayOfWeek   DayOfWeek
  locationId  String?
  name        String     // e.g. "Industry Night", "Classic Tuesday"
  tagline     String?
  description String?
  // Optional hex color (e.g. "#d4af37") that themes the public specials
  // page header for this day. Falls back to the brand gold if null.
  themeColor  String?
  isActive    Boolean    @default(true)

  halfPriceConfig Json?    // Selection rules for half-price spirits (Wed/Thu)

  location    Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  specials    DailySpecial[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([dayOfWeek, locationId])
  @@index([dayOfWeek])
}

model DailySpecial {
  id           String   @id @default(uuid())
  dayThemeId   String
  name         String
  description  String?
  price        String?  // Flexible: "$8", "50% off", "2-for-1"
  imageUrl     String?
  category     String?  // e.g. "cocktail", "beer", "food"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  // Rich content fields
  section      String?  // Groups specials under a header: "$8 Cocktails", "$5 Shots & More"
  detailText   String?  // Longer sell copy / tasting notes paragraph
  badges       String?  // Comma-separated tags: "New", "Staff Pick", "LTO"
  timeWindow   String?  // Time constraint: "Until 7 PM", "All night"
  isFeatured   Boolean  @default(false) // Gold border / visual emphasis

  dayTheme     DayTheme @relation(fields: [dayThemeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dayThemeId])
}

model Flight {
  id          String      @id @default(uuid())
  locationId  String?
  month       Int         // 1-12
  year        Int
  theme       String      // e.g. "American Single Malts"
  description String?
  price       String?     // e.g. "$15"
  isActive    Boolean     @default(true)

  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pours       FlightPour[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([month, year, locationId])
  @@index([month, year])
}

model FlightPour {
  id           String  @id @default(uuid())
  flightId     String
  spiritName   String
  pourSize     String? // e.g. "1 oz"
  description  String?
  tastingNotes String?
  displayOrder Int     @default(0)

  flight       Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
}

// A Limited-Time Offer that lays a separate small menu (image + drinks list)
// on top of a location's normal day specials. Multiple LTOs per location are
// allowed; each runs on a chosen set of weekdays and optionally within a
// start/end date window.
model LimitedTimeOffer {
  id          String     @id @default(uuid())
  locationId  String
  title       String
  description String?
  // Base64 data URL or external https URL (handled the same way as event
  // images by sanitizeImageSrc). Capped client-side at ~750 KB.
  image       String?    @db.Text
  // Drinks: [{name, description?, price?, displayOrder?}]
  drinks      Json?
  daysOfWeek  DayOfWeek[]
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  location    Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, isActive])
}

model FeaturedBottle {
  id           String   @id @default(uuid())
  locationId   String?
  month        Int      // 1-12
  year         Int
  name         String
  description  String?
  regularPrice String?  // What it normally costs
  costPrice    String   // Break-even price
  category     String?  // e.g. "bourbon", "scotch"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  location     Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([month, year])
}

model MenuCategory {
  id          String   @id @default(uuid())
  locationId  String
  name        String
  description String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)

  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
}

model MenuItem {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  displayOrder Int     @default(0)

  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Event {
  id               String    @id @default(uuid())
  locationId       String
  slug             String    // URL slug, unique per location
  title            String
  description      String?
  startDate        DateTime  // When the event happens
  endDate          DateTime?
  image            String?   // Banner image URL

  // Promotion window — when the event is visible / accepting signups
  promoteFrom      DateTime? // Defaults to createdAt if null
  promoteUntil     DateTime? // Defaults to startDate if null

  // Capacity
  capacity         Int?      // null = unlimited

  // Controls the public "X spots left" urgency indicator.
  //   "always"    → show whenever capacity is set
  //   "near-full" → only show once the event is ≥75% full
  //   "hidden"    → never show
  spotsLeftMode    String    @default("always")

  // Whether the signup form is shown at all on the public page.
  // Some events (e.g. info-only announcements) don't collect signups.
  signupsEnabled   Boolean   @default(true)

  // Standard signup field toggles (name is always required)
  collectEmail     Boolean   @default(true)
  collectPhone     Boolean   @default(true)
  collectPartySize Boolean   @default(false)
  collectNotes     Boolean   @default(false)

  // Custom questions as JSON: [{id, label, type, required}]
  customQuestions  Json?

  // Page content sections (rich event page builder).
  // JSON array of {id, type, ...content} entries rendered in order.
  // Types: text, image, details, button, video, divider
  sections         Json?

  // Post-signup
  confirmationMessage String?
  notifyEmail      String?   // Email to notify when someone signs up

  // State
  isActive         Boolean   @default(true)
  isCancelled      Boolean   @default(false)

  // Vendor events route signups through a GM approval queue instead of
  // confirming instantly. Re-labels the signup form as a vendor application.
  // Kept for backward compatibility; new code should read `signupType`.
  isVendorEvent    Boolean   @default(false)

  // Signup mode. "guest" (default) = standard RSVP that confirms instantly.
  // "vendor" = outside business / artist applying for a slot, gated by
  //   approval queue (legacy isVendorEvent = true maps here).
  // "participant" = anyone signing up to *take part* in the event (e.g.
  //   bartenders entering a cocktail competition, performers, contestants).
  //   Also gated by an approval queue. Form copy adapts based on this value.
  signupType       String    @default("guest")

  // Optional visual theme override for the public event page.
  // Known values: "spring-market" (soft green/peach garden party),
  //               "art-gallery" (purple damask, paint drips, gallery vibe).
  // null/unknown falls back to the default dark vintage theme.
  themeKey         String?

  // Ticketing. ticketUrl is the customer-facing buy-tickets link (currently
  // always Eventbrite; future providers possible). ticketProvider is the
  // canonical source so we can render provider-specific UI (logo, copy).
  ticketUrl        String?
  ticketProvider   String?   // "eventbrite" | null

  // Reminder emails for confirmed signups. Defaults to on; can be disabled
  // per event (e.g. info-only events that don't really need a T-24h ping).
  remindersEnabled Boolean   @default(true)

  location         Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  signups          EventSignup[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([locationId, slug])
  @@index([locationId, startDate])
  @@index([slug])
}

model EventSignup {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  email         String?
  phone         String?
  partySize     Int?
  notes         String?
  customAnswers Json?
  ipAddress     String?
  visitorId     String?
  sessionId     String?
  source        String?
  createdAt     DateTime @default(now())

  // Approval workflow (used by vendor events). Regular events leave status="approved".
  // "waitlisted" is used when an event is at capacity but still collecting
  // interest; waitlisted signups don't count toward capacity and can be
  // promoted to "approved" by an admin when a spot frees up.
  status           String    @default("approved") // "approved" | "pending" | "rejected" | "waitlisted"
  approvedBy       String?   // Email of GM who approved/rejected
  approvedAt       DateTime?
  rejectionReason  String?

  // Day-of check-in. Set when an admin marks the guest as arrived; null = not
  // yet checked in. Enables attendance / no-show reporting after the event.
  checkedInAt      DateTime?

  // Reminder email tracking. Flag-then-send pattern (see eventReminders.js):
  // we set the flag BEFORE attempting send so a crash mid-send can't fire a
  // duplicate. unsubscribeToken is a random per-signup secret used to honor
  // one-click opt-out without exposing signup IDs.
  reminderSent24h  Boolean   @default(false)
  reminderSent1h   Boolean   @default(false)
  remindersOptOut  Boolean   @default(false)
  unsubscribeToken String?

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, status])
  @@index([visitorId])
  @@index([source])
}

model JobApplication {
  id              String   @id @default(uuid())
  locationId      String

  // Applicant identity
  name            String
  email           String
  phone           String?

  // Position + eligibility
  position        String   // "Bartender" | "Barback" | "Server" | "Host" | "Floor Manager" | "Other"
  positionOther   String?  // free text when position == "Other"
  age21           Boolean  @default(false)
  // Bartender-only: "yes" / "no" / "unsure" — legal eligibility to perform
  // alcohol-service duties for the role at the location. Replaces age21 as
  // the deal-breaker signal (age21 stays for backwards-compat with older
  // applications).
  alcoholEligibility String?
  earliestStart   DateTime?

  // Availability stored as JSON: { mon: ["day","evening","late"], tue: [...], ... }
  availability    Json?

  // Experience + narrative
  yearsExperience Int?
  priorEmployers  String?
  certifications  String?  // TIPS, ServSafe, ABC, etc. (free text)
  spiritKnowledge String?
  whyDD           String?
  referredBy      String?

  // Resume: base64 data URL (PDF/DOC/DOCX/JPG/PNG, capped 5MB) + filename for the
  // download link in the admin view. We never include this in notification emails.
  resumeData      String?  @db.Text
  resumeFileName  String?
  resumeMimeType  String?

  // Pipeline
  status          String   @default("new")
                  // "new" | "reviewing" | "interview_scheduled" | "interviewed"
                  // | "offer_extended" | "hired" | "rejected" | "withdrawn"
  decisionBy      String?
  decisionAt      DateTime?
  decisionNote    String?
  internalNotes   String?  // GM-only

  // Tracking
  ipAddress       String?
  visitorId       String?
  sessionId       String?
  source          String?
  // Last time we emailed this applicant the questionnaire link (backfill script
  // sets this; null means we have not yet invited them via that flow).
  questionnaireInviteSentAt DateTime?
  // Auto-reminder bookkeeping. 24h fires before 72h; flags prevent re-sends.
  questionnaireReminder24hSent Boolean @default(false)
  questionnaireReminder72hSent Boolean @default(false)

  // Bartender Dashboard onboarding invite (set once we POST to bartender DB's
  // EmployeeInvite table after hiring). Token lets us deep-link / re-fetch
  // status from the bartender side.
  dashboardInviteId         String?
  dashboardInviteToken      String?
  dashboardInviteSentAt     DateTime?
  dashboardInviteRole       String?  // bartender Role enum value: BARTENDER, SERVER_BARBACK, HOST, ...

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location      Location                       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  questionnaire JobApplicationQuestionnaire?
  aiEvaluation  JobApplicationAiEvaluation?

  @@index([locationId, status])
  @@index([locationId, createdAt])
  @@index([email])
  @@index([visitorId])
}

// Stores answers to the 20-question hiring questionnaire. One row per application.
model JobApplicationQuestionnaire {
  id            String   @id @default(uuid())
  applicationId String   @unique
  // Schema for `answers`: { "q1": "answer text", "q2": "...", ... }
  answers       Json
  version       String   // questionnaire version stamp from hiring/knowledgeBase.js
  submittedAt   DateTime @default(now())

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// AI evaluation produced by Claude against the Dram & Draught hiring rubric.
// One row per application. Code recomputes weightedScore + recommendation; AI's
// claimed values are stored for audit but not trusted for decisions.
model JobApplicationAiEvaluation {
  id                      String   @id @default(uuid())
  applicationId           String   @unique

  // Result fields (code-enforced after AI returns)
  recommendation          String   // "strong_callback" | "callback" | "maybe" | "hold"
  weightedScore           Float
  confidence              String   // "high" | "medium" | "low"
  humanReviewRequired     Boolean  @default(false)
  humanReviewReasons      Json     // string[]

  // Narrative
  candidateSummary        String
  // "Why a manager might like this candidate" — required by v6 of the rubric
  // so every evaluation surfaces job-related upside before listing watch-outs.
  // Nullable for backfill compatibility with older rows.
  positiveSignalSummary   String?
  overallRationale        String
  jobRelatedConcerns      Json     // string[]
  suggestedInterviewQuestions Json // string[]
  possibleBetterRoleFit   String?

  // Category scores: [{ category, score, weight, evidence: string[], rationale, concerns: string[] }]
  categoryScores          Json

  // Provenance + audit
  modelName               String   // e.g. "claude-opus-4-7"
  promptVersion           String   // from hiring/knowledgeBase.js
  knowledgeBaseVersion    String
  rawAiPayload            Json?    // verbatim parsed AI response, for debugging
  errorDetail             String?  // populated if eval failed

  createdAt               DateTime @default(now())

  application             JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Interview {
  id                  String   @id @default(uuid())
  applicationId       String
  locationId          String

  scheduledAt         DateTime
  durationMinutes     Int      @default(30)
  type                String   @default("in_person") // "in_person" | "phone" | "video"
  locationDetail      String?  // address, phone number, or meeting URL
  interviewerEmail    String?
  candidateNote       String?  // shown to applicant in confirmation email
  internalNotes       String?

  status              String   @default("scheduled")
                      // "scheduled" | "completed" | "cancelled" | "no_show"
  cancelledAt         DateTime?
  cancellationReason  String?

  // How the candidate was reached, if the admin contacted them outside email.
  contactMethod       String?  // "phone" | "text" | "in_person" | "email_manual" | "other"
  contactNote         String?  // free-text detail (who, when, what was said)

  // Reminder bookkeeping (separate flags so 24h fires before 1h)
  reminderSent24h     Boolean  @default(false)
  reminderSent1h      Boolean  @default(false)
  confirmationSentAt  DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  location    Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt, status])
  @@index([locationId, status, scheduledAt])
}

model BottleNotesCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  notesJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cacheKey])
}

model GuestFeedback {
  id              String   @id @default(uuid())
  locationId      String?
  locationName    String
  locationSlug    String
  rating          Int
  guestName       String?
  guestEmail      String?
  feedbackText    String
  newsletterOptIn Boolean  @default(false)
  giftCardOptIn   Boolean  @default(false)
  visitorId        String?
  sessionId        String?
  source           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([createdAt])
  @@index([visitorId])
  @@index([source])
}

model VisitorSession {
  id            String   @id @default(uuid())
  visitorId     String
  locationId    String?
  locationSlug  String
  ipAddress     String?
  userAgent     String?
  deviceType    String?
  browser       String?
  os            String?
  screenWidth   Int?
  screenHeight  Int?
  language      String?
  referrer      String?
  isQrScan      Boolean  @default(true)
  source        String?  // Traffic source from ?src= or ?utm_source= (e.g. "instagram", "event", "qr")
  medium        String?  // Traffic medium from ?utm_medium= (e.g. "social", "email", "print")
  campaign      String?  // Campaign from ?campaign= or ?utm_campaign=
  qrId          String?  // Specific QR placement/code from ?qr= or ?qrid=
  entryPage     String
  pageCount     Int      @default(1)
  durationSecs  Int?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  pageViews     PageView[]

  @@index([visitorId])
  @@index([locationSlug])
  @@index([startedAt])
  @@index([locationSlug, startedAt])
  @@index([source])
  @@index([campaign])
  @@index([qrId])
}

model PageView {
  id            String   @id @default(uuid())
  sessionId     String
  visitorId     String
  locationSlug  String
  pagePath      String
  pageType      String
  queryString   String?
  viewedAt      DateTime @default(now())

  session       VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([locationSlug, viewedAt])
  @@index([pageType])
  @@index([viewedAt])
}

model GuestVisitorLink {
  id                String   @id @default(uuid())
  emailHash         String
  emailMasked       String
  visitorId         String
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @updatedAt
  firstLocationSlug String?
  lastLocationSlug  String?
  firstSource       String?
  lastSource        String?
  giftCardOptIn     Boolean  @default(false)
  newsletterOptIn   Boolean  @default(false)
  feedbackCount     Int      @default(0)
  eventSignupCount  Int      @default(0)

  @@unique([emailHash, visitorId])
  @@index([emailHash])
  @@index([visitorId])
  @@index([lastSeenAt])
  @@index([lastLocationSlug])
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  eventType     String
  visitorId     String?
  sessionId     String?
  emailHash     String?
  emailMasked   String?
  locationId    String?
  locationSlug  String?
  source        String?
  medium        String?
  campaign      String?
  qrId          String?
  pagePath      String?
  entityType    String?
  entityId      String?
  entityName    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([visitorId])
  @@index([emailHash])
  @@index([locationSlug, createdAt])
  @@index([source])
  @@index([campaign])
  @@index([qrId])
  @@index([entityType, entityId])
}

model GiftCardDrawing {
  id            String   @id @default(uuid())
  month         Int
  year          Int
  winnerId      String?
  winnerName    String?
  winnerEmail   String
  locationName  String?
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, year])
}

// Audit log: tracks every mutation made via the admin so multi-admin
// teams can see who changed what and when. Best-effort — failures to
// write are swallowed so they never break the user-facing operation.
model AuditLog {
  id            String   @id @default(uuid())
  // Who: copied from session at write time so deleted users still resolve
  userId        String?
  userEmail     String?
  userName      String?
  // What
  action        String   // e.g. "create", "update", "delete", "duplicate"
  resourceType  String   // e.g. "event", "menu_item", "daily_special"
  resourceId    String?  // entity id, when applicable
  resourceLabel String?  // human-readable name at the time, e.g. "Lubrication Cup"
  locationSlug  String?  // optional location scope
  // Optional structured details (changed fields, before/after, etc.)
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, createdAt])
  @@index([userId, createdAt])
  @@index([locationSlug, createdAt])
}
