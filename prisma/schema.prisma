// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  name        String   // Greensboro, Raleigh, Durham, etc.
  slug        String   @unique // URL slug: greensboro, raleigh, etc.
  address     String?
  city        String
  state       String   @default("NC")
  zipCode     String?
  phone       String?
  email       String?
  hours       Json?    // Store hours as JSON object
  links       Json?    // Linktree-style buttons: [{label, url}]
  description String?
  image       String?  // URL to location image
  qrCode      String?  // URL to QR code image

  // Location-specific content
  menuUrl     String?  // Link to menu
  specialText String?  // Special announcements
  features    String[] // Array of features: ["outdoor seating", "delivery", etc.]

  // Social media links
  facebook    String?
  instagram   String?
  twitter     String?

  // Status
  isActive    Boolean  @default(true)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  menuCategories   MenuCategory[]
  events           Event[]
  dayThemes        DayTheme[]
  flights          Flight[]
  featuredBottles  FeaturedBottle[]
  guestFeedbacks   GuestFeedback[]
  visitorSessions  VisitorSession[]

  @@index([slug])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model DayTheme {
  id          String     @id @default(uuid())
  dayOfWeek   DayOfWeek
  locationId  String?
  name        String     // e.g. "Industry Night", "Classic Tuesday"
  tagline     String?
  description String?
  // Optional hex color (e.g. "#d4af37") that themes the public specials
  // page header for this day. Falls back to the brand gold if null.
  themeColor  String?
  isActive    Boolean    @default(true)

  halfPriceConfig Json?    // Selection rules for half-price spirits (Wed/Thu)

  location    Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  specials    DailySpecial[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([dayOfWeek, locationId])
  @@index([dayOfWeek])
}

model DailySpecial {
  id           String   @id @default(uuid())
  dayThemeId   String
  name         String
  description  String?
  price        String?  // Flexible: "$8", "50% off", "2-for-1"
  imageUrl     String?
  category     String?  // e.g. "cocktail", "beer", "food"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  // Rich content fields
  section      String?  // Groups specials under a header: "$8 Cocktails", "$5 Shots & More"
  detailText   String?  // Longer sell copy / tasting notes paragraph
  badges       String?  // Comma-separated tags: "New", "Staff Pick", "LTO"
  timeWindow   String?  // Time constraint: "Until 7 PM", "All night"
  isFeatured   Boolean  @default(false) // Gold border / visual emphasis

  dayTheme     DayTheme @relation(fields: [dayThemeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dayThemeId])
}

model Flight {
  id          String      @id @default(uuid())
  locationId  String?
  month       Int         // 1-12
  year        Int
  theme       String      // e.g. "American Single Malts"
  description String?
  price       String?     // e.g. "$15"
  isActive    Boolean     @default(true)

  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pours       FlightPour[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([month, year, locationId])
  @@index([month, year])
}

model FlightPour {
  id           String  @id @default(uuid())
  flightId     String
  spiritName   String
  pourSize     String? // e.g. "1 oz"
  description  String?
  tastingNotes String?
  displayOrder Int     @default(0)

  flight       Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
}

model FeaturedBottle {
  id           String   @id @default(uuid())
  locationId   String?
  month        Int      // 1-12
  year         Int
  name         String
  description  String?
  regularPrice String?  // What it normally costs
  costPrice    String   // Break-even price
  category     String?  // e.g. "bourbon", "scotch"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  location     Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([month, year])
}

model MenuCategory {
  id          String   @id @default(uuid())
  locationId  String
  name        String
  description String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)

  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
}

model MenuItem {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  displayOrder Int     @default(0)

  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Event {
  id               String    @id @default(uuid())
  locationId       String
  slug             String    // URL slug, unique per location
  title            String
  description      String?
  startDate        DateTime  // When the event happens
  endDate          DateTime?
  image            String?   // Banner image URL

  // Promotion window — when the event is visible / accepting signups
  promoteFrom      DateTime? // Defaults to createdAt if null
  promoteUntil     DateTime? // Defaults to startDate if null

  // Capacity
  capacity         Int?      // null = unlimited

  // Whether the signup form is shown at all on the public page.
  // Some events (e.g. info-only announcements) don't collect signups.
  signupsEnabled   Boolean   @default(true)

  // Standard signup field toggles (name is always required)
  collectEmail     Boolean   @default(true)
  collectPhone     Boolean   @default(true)
  collectPartySize Boolean   @default(false)
  collectNotes     Boolean   @default(false)

  // Custom questions as JSON: [{id, label, type, required}]
  customQuestions  Json?

  // Page content sections (rich event page builder).
  // JSON array of {id, type, ...content} entries rendered in order.
  // Types: text, image, details, button, video, divider
  sections         Json?

  // Post-signup
  confirmationMessage String?
  notifyEmail      String?   // Email to notify when someone signs up

  // State
  isActive         Boolean   @default(true)
  isCancelled      Boolean   @default(false)

  // Vendor events route signups through a GM approval queue instead of
  // confirming instantly. Re-labels the signup form as a vendor application.
  isVendorEvent    Boolean   @default(false)

  // Optional visual theme override for the public event page.
  // Known values: "spring-market" (soft green/peach garden party),
  //               "art-gallery" (purple damask, paint drips, gallery vibe).
  // null/unknown falls back to the default dark vintage theme.
  themeKey         String?

  location         Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  signups          EventSignup[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([locationId, slug])
  @@index([locationId, startDate])
  @@index([slug])
}

model EventSignup {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  email         String?
  phone         String?
  partySize     Int?
  notes         String?
  customAnswers Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Approval workflow (used by vendor events). Regular events leave status="approved".
  status           String    @default("approved") // "approved" | "pending" | "rejected"
  approvedBy       String?   // Email of GM who approved/rejected
  approvedAt       DateTime?
  rejectionReason  String?

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, status])
}

model BottleNotesCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  notesJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cacheKey])
}

model GuestFeedback {
  id              String   @id @default(uuid())
  locationId      String?
  locationName    String
  locationSlug    String
  rating          Int
  guestName       String?
  guestEmail      String?
  feedbackText    String
  newsletterOptIn Boolean  @default(false)
  giftCardOptIn   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([createdAt])
}

model VisitorSession {
  id            String   @id @default(uuid())
  visitorId     String
  locationId    String?
  locationSlug  String
  ipAddress     String?
  userAgent     String?
  deviceType    String?
  browser       String?
  os            String?
  screenWidth   Int?
  screenHeight  Int?
  language      String?
  referrer      String?
  isQrScan      Boolean  @default(true)
  source        String?  // Traffic source from ?src= or ?utm_source= (e.g. "instagram", "event", "qr")
  entryPage     String
  pageCount     Int      @default(1)
  durationSecs  Int?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  pageViews     PageView[]

  @@index([visitorId])
  @@index([locationSlug])
  @@index([startedAt])
  @@index([locationSlug, startedAt])
  @@index([source])
}

model PageView {
  id            String   @id @default(uuid())
  sessionId     String
  visitorId     String
  locationSlug  String
  pagePath      String
  pageType      String
  queryString   String?
  viewedAt      DateTime @default(now())

  session       VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([locationSlug, viewedAt])
  @@index([pageType])
  @@index([viewedAt])
}

model GiftCardDrawing {
  id            String   @id @default(uuid())
  month         Int
  year          Int
  winnerId      String?
  winnerName    String?
  winnerEmail   String
  locationName  String?
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, year])
}

// Audit log: tracks every mutation made via the admin so multi-admin
// teams can see who changed what and when. Best-effort — failures to
// write are swallowed so they never break the user-facing operation.
model AuditLog {
  id            String   @id @default(uuid())
  // Who: copied from session at write time so deleted users still resolve
  userId        String?
  userEmail     String?
  userName      String?
  // What
  action        String   // e.g. "create", "update", "delete", "duplicate"
  resourceType  String   // e.g. "event", "menu_item", "daily_special"
  resourceId    String?  // entity id, when applicable
  resourceLabel String?  // human-readable name at the time, e.g. "Lubrication Cup"
  locationSlug  String?  // optional location scope
  // Optional structured details (changed fields, before/after, etc.)
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, createdAt])
  @@index([userId, createdAt])
  @@index([locationSlug, createdAt])
}
