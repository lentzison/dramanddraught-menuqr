// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(uuid())
  name        String   // Greensboro, Raleigh, Durham, etc.
  slug        String   @unique // URL slug: greensboro, raleigh, etc.
  address     String?
  city        String
  state       String   @default("NC")
  zipCode     String?
  phone       String?
  email       String?
  hours       Json?    // Store hours as JSON object
  links       Json?    // Linktree-style buttons: [{label, url}]
  description String?
  image       String?  // URL to location image
  qrCode      String?  // URL to QR code image

  // Location-specific content
  menuUrl     String?  // Link to menu
  specialText String?  // Special announcements
  features    String[] // Array of features: ["outdoor seating", "delivery", etc.]

  // Social media links
  facebook    String?
  instagram   String?
  twitter     String?

  // Status
  isActive    Boolean  @default(true)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  menuCategories   MenuCategory[]
  events           Event[]
  dayThemes        DayTheme[]
  flights          Flight[]
  featuredBottles  FeaturedBottle[]
  guestFeedbacks   GuestFeedback[]

  @@index([slug])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model DayTheme {
  id          String     @id @default(uuid())
  dayOfWeek   DayOfWeek
  locationId  String?
  name        String     // e.g. "Industry Night", "Classic Tuesday"
  tagline     String?
  description String?
  isActive    Boolean    @default(true)

  location    Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  specials    DailySpecial[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([dayOfWeek, locationId])
  @@index([dayOfWeek])
}

model DailySpecial {
  id           String   @id @default(uuid())
  dayThemeId   String
  name         String
  description  String?
  price        String?  // Flexible: "$8", "50% off", "2-for-1"
  imageUrl     String?
  category     String?  // e.g. "cocktail", "beer", "food"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  // Rich content fields
  section      String?  // Groups specials under a header: "$8 Cocktails", "$5 Shots & More"
  detailText   String?  // Longer sell copy / tasting notes paragraph
  badges       String?  // Comma-separated tags: "New", "Staff Pick", "LTO"
  timeWindow   String?  // Time constraint: "Until 7 PM", "All night"
  isFeatured   Boolean  @default(false) // Gold border / visual emphasis

  dayTheme     DayTheme @relation(fields: [dayThemeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dayThemeId])
}

model Flight {
  id          String      @id @default(uuid())
  locationId  String?
  month       Int         // 1-12
  year        Int
  theme       String      // e.g. "American Single Malts"
  description String?
  price       String?     // e.g. "$15"
  isActive    Boolean     @default(true)

  location    Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pours       FlightPour[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([month, year, locationId])
  @@index([month, year])
}

model FlightPour {
  id           String  @id @default(uuid())
  flightId     String
  spiritName   String
  pourSize     String? // e.g. "1 oz"
  description  String?
  tastingNotes String?
  displayOrder Int     @default(0)

  flight       Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
}

model FeaturedBottle {
  id           String   @id @default(uuid())
  locationId   String?
  month        Int      // 1-12
  year         Int
  name         String
  description  String?
  regularPrice String?  // What it normally costs
  costPrice    String   // Break-even price
  category     String?  // e.g. "bourbon", "scotch"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  location     Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([month, year])
}

model MenuCategory {
  id          String   @id @default(uuid())
  locationId  String
  name        String
  description String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)

  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
}

model MenuItem {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  displayOrder Int     @default(0)

  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Event {
  id          String   @id @default(uuid())
  locationId  String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  image       String?
  isActive    Boolean  @default(true)

  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId, startDate])
}

model GuestFeedback {
  id              String   @id @default(uuid())
  locationId      String?
  locationName    String
  locationSlug    String
  rating          Int
  guestName       String?
  guestEmail      String?
  feedbackText    String
  newsletterOptIn Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([createdAt])
}
